# --- Data ---------------------------------------------------------------
# The whole data tree is untracked. Inputs (raw/ and interim/open-refine/) are
# distributed as a versioned zip -- unzip it into the project root; setup
# instructions go out over Slack. Everything else under data/ is regenerated by
# `python -m src.run_pipeline`, which creates its own directories.
#
# At submission the raw and cleaned datasets go to *Box*, with the link in
# deliverables/phase2/DataLinks.txt -- the course instructions require Box and
# forbid datasets in the supplementary ZIP.
data/

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- OpenRefine ---------------------------------------------------------
# The local workspace is machine-specific; only the exported history is tracked.
*.openrefine.tar.gz
openrefine/workspace/

# --- Editors / OS -------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
ehthumbs.db
.DS_Store

# --- Local secrets / connection settings --------------------------------
.env
*.local.ini
